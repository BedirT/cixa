{
  "name": "cixa-demo",
  "version": "1.0.0",
  "description": "The reproducible Cixa product walkthrough",
  "repository": "https://github.com/BedirT/cixa",
  "license": "AGPL-3.0-only",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.512",
    "@remotion/fonts": "4.0.512",
    "@remotion/media": "4.0.512",
    "@remotion/transitions": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.512",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "^9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "voiceover": "python3 scripts/generate_voiceover.py",
    "render": "remotion render CixaDemo ../../docs/assets/cixa-demo.mp4 --codec h264 --crf 18 --audio-bitrate 192k",
    "still": "remotion still CixaDemo ../../docs/assets/cixa-demo-poster.png --frame 90",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}

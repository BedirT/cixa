{
  "name": "cixa-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": "github:BedirT/cixa",
  "type": "module",
  "workspaces": [
    "packages/sdk-typescript",
    "packages/mcp-server",
    "packages/checkout-playwright"
  ],
  "scripts": {
    "build": "tsc -b packages/sdk-typescript packages/mcp-server packages/checkout-playwright",
    "test": "node --test packages/sdk-typescript/test/*.test.mjs packages/checkout-playwright/test/*.test.mjs",
    "test:packages": "python3 tests/package-smoke.py",
    "format:check": "tsc -b packages/sdk-typescript packages/mcp-server packages/checkout-playwright --pretty false"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.0"
  }
}

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VERIFY_LOCK="$(git rev-parse --git-path agent-treasury-verify.lock 2>/dev/null || printf '%s' "$ROOT/.verify.lock")"
VERIFY_OWNER="$VERIFY_LOCK/owner"
if ! mkdir "$VERIFY_LOCK" 2>/dev/null; then
  owner_pid="$(sed -n '1p' "$VERIFY_OWNER" 2>/dev/null || true)"
  owner_command="$(ps -p "$owner_pid" -o command= 2>/dev/null || true)"
  if [[ "$owner_pid" =~ ^[0-9]+$ ]] && kill -0 "$owner_pid" 2>/dev/null \
      && [[ "$owner_command" == *"scripts/verify"* ]]; then
    printf '%s\n' 'another local verification run owns this checkout; retry after it completes' >&2
    exit 1
  fi
  stale_lock="$VERIFY_LOCK.stale.$$"
  if ! mv "$VERIFY_LOCK" "$stale_lock" 2>/dev/null; then
    printf '%s\n' 'verification lock changed while checking its owner; retry' >&2
    exit 1
  fi
  rm -rf "$stale_lock"
  mkdir "$VERIFY_LOCK"
fi
printf '%s\n' "$$" > "$VERIFY_OWNER"

CANARY_SCAN_COMPLETED=0
cleanup() {
  status=$?
  trap - EXIT
  if [[ "$CANARY_SCAN_COMPLETED" == "0" && -d build/handoff-artifacts ]]; then
    if ! python3 scripts/secret-canary-scan.py build; then
      status=1
    fi
  fi
  if [[ "$(sed -n '1p' "$VERIFY_OWNER" 2>/dev/null || true)" == "$$" ]]; then
    rm -rf "$VERIFY_LOCK"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM

if [[ "$(python3 -c 'import sys; print(sys.flags.optimize)')" != "0" ]]; then
  printf '%s\n' 'optimized Python disables security assertions; unset PYTHONOPTIMIZE' >&2
  exit 1
fi

printf '%s\n' '[1/14] Rust format'
cargo fmt --all -- --check
printf '%s\n' '[2/14] Rust build'
cargo build --locked --workspace
printf '%s\n' '[3/14] Rust clippy'
cargo clippy --locked --workspace --all-targets -- -D warnings
printf '%s\n' '[4/14] Rust tests'
cargo test --locked --workspace
printf '%s\n' '[5/14] Fuzz harness build'
cargo check --locked --manifest-path fuzz/Cargo.toml --bins
printf '%s\n' '[6/14] Node dependencies and build'
npm ci --ignore-scripts
npm run build
printf '%s\n' '[7/14] Node tests'
npm test
node tests/mcp-smoke.mjs
python3 tests/package-smoke.py
printf '%s\n' '[8/14] Python tests and compile'
PYTHONPATH="$ROOT/packages/sdk-python" python3 -m unittest discover -s packages/sdk-python/tests
python3 -m py_compile apps/owner-dashboard/server.py packages/sdk-python/agent_treasury.py tests/*.py scripts/*.py
printf '%s\n' '[9/14] Persisted daemon integration'
PYTHONPATH="$ROOT/packages/sdk-python" python3 tests/integration.py
python3 tests/handoff.py
printf '%s\n' '[10/14] Owner dashboard integration'
python3 tests/dashboard.py
printf '%s\n' '[11/14] Adversarial demo'
python3 tests/adversarial.py
printf '%s\n' '[12/14] Documentation and supply chain'
python3 scripts/check-docs.py
python3 scripts/dependency-check.py
python3 scripts/license-check.py
python3 scripts/sbom.py
printf '%s\n' '[13/14] Secret-canary scan'
python3 scripts/secret-canary-scan.py build --require handoff-artifacts/helper-success.stdout --require handoff-artifacts/helper-success.stderr --require handoff-artifacts/helper-timeout.stdout --require handoff-artifacts/helper-timeout.stderr --require handoff-artifacts/execute-timeout.stdout --require handoff-artifacts/execute-timeout.stderr
CANARY_SCAN_COMPLETED=1
if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' 'gitleaks 8.30.1 is required for source-tree secret scanning' >&2
  exit 1
fi
if [[ "$(gitleaks version)" != "8.30.1" ]]; then
  printf '%s\n' 'gitleaks 8.30.1 is required for deterministic source-tree secret scanning' >&2
  exit 1
fi
gitleaks dir --redact --no-banner .
printf '%s\n' '[14/14] Verification complete'
printf '%s\n' 'agent-treasury verification passed'
